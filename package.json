{
  "name": "td4-web-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "TD4 4-bit CPU browser emulator",
  "scripts": {
    "build": "node scripts/generate-netlist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/generate-netlist.mjs && tsc --noEmit -p tsconfig.json && node --test tests/*.cjs",
    "verify": "node scripts/generate-netlist.mjs && tsc -p tsconfig.json && tsc --noEmit -p tsconfig.json && node --test tests/*.cjs",
    "lint": "node scripts/check-style.mjs && pnpm run format:check",
    "format": "prettier --write \"src/core/*.ts\" \"src/data/*.ts\" \"src/types/*.d.ts\"",
    "format:check": "prettier --check \"src/core/*.ts\" \"src/data/*.ts\" \"src/types/*.d.ts\""
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "prettier": "3.6.2"
  },
  "packageManager": "pnpm@9.14.2"
}
