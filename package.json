{
  "name": "td4-web-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "TD4 4-bit CPU browser emulator",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.json && node --test tests/*.cjs",
    "verify": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.json && node --test tests/*.cjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.14.2"
}
